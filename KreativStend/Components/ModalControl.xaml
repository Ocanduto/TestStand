<UserControl x:Class="KreativStend.Components.ModalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KreativStend.Components"
             mc:Ignorable="d" 
             x:Name="root"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#B3B3B3">
    <DockPanel LastChildFill="True" Margin="20">
        <Border DockPanel.Dock="Top" 
                Background="White"
                BorderBrush="Black"
                BorderThickness="1">
            <Grid>
                <Label Content="{Binding ElementName=root, Path=Header}"/>
                <Image Width="25" Source="/Resources/KR.png" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" 
                Background="White"
                BorderBrush="Black"
                BorderThickness="1,0,1,1">    
            <StackPanel Margin="10,5" x:Name="PART_Bottom" VerticalAlignment="Center"/>
        </Border>
        <Border Background="White"
                BorderBrush="Black"
                BorderThickness="1,0">
            <StackPanel Margin="10,5" x:Name="PART_Host" VerticalAlignment="{Binding ElementName=root, Path=ContentVerticalAlignment}"/>
        </Border>
    </DockPanel>
</UserControl>
