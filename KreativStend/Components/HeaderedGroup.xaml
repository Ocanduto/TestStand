<UserControl x:Class="KreativStend.Components.HeaderedGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KreativStend.Components"
             mc:Ignorable="d" 
             x:Name="root"
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#666666"
            CornerRadius="5">
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Top"
                    Background="#999999"
                    BorderBrush="#666666"
                    BorderThickness="2"
                    Margin="10,-14,10,0"
                    CornerRadius="5">
                <Label Content="{Binding ElementName=root, Path=Title}" 
                       HorizontalContentAlignment="Center"
                       Foreground="White"/>
            </Border>

            <StackPanel Margin="10,5" x:Name="PART_Host"/>
        </DockPanel>
    </Border>
</UserControl>
