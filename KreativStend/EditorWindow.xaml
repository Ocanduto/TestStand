<Window x:Class="KreativStend.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KreativStend"
        mc:Ignorable="d"
        Title="Ввод значения" 
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Height="200" Width="300">
    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Bottom" Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="OK" Grid.Column="0"/>
            <Button Content="..." Grid.Column="1" Padding="10"/>
            <Button Content="Отмена" Grid.Column="2"/>
        </Grid>
        <TextBox VerticalScrollBarVisibility="Visible"/>
    </DockPanel>
</Window>
