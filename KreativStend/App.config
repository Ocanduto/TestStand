                <value>http://127.0.0.1:8080</value>
            </setting>
            <setting name="TimeSolenoidEnableSec" serializeAs="String">
                <value>10</value>
            </setting>
            <setting name="ScriptsFolder" serializeAs="String">
                <value>C:\Scripts</value>
            </setting>
            <setting name="TurnsCount" serializeAs="String">
                <value>3</value>
            </setting>
            <setting name="DefaultScript" serializeAs="String">
                <value>Test</value>
            </setting>
            <setting name="Tens_On" serializeAs="String">
                <value>False</value>
            </setting>
        </KreativStend.Properties.Settings>
    </applicationSettings>
    <userSettings>
        <KreativStend.Properties.Settings>
            <setting name="Coefs" serializeAs="Xml">
                <value>
                    <ArrayOfString xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <string>0:105</string>
                        <string>1:105</string>
                    </ArrayOfString>
                </value>
            </setting>
