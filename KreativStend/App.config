                <value>192.168.102.152</value>
            </setting>
            <setting name="Port" serializeAs="String">
                <value>502</value>
            </setting>
            <setting name="Temperature_Low" serializeAs="String">
                <value>70</value>
            </setting>
            <setting name="Temperature_High" serializeAs="String">
                <value>80</value>
            </setting>
            <setting name="MotorSpeed" serializeAs="String">
                <value>600</value>
            </setting>
            <setting name="GerTime" serializeAs="String">
                <value>1000</value>
            </setting>
        </KreativStend.Properties.Settings>
