<Window x:Class="KreativStend.SensorConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка лимитов датчиков"
        Height="720"
        Width="900"
        MinHeight="600"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F8">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="115"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Конфигуратор датчиков"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="#243247"/>
            <TextBlock Text="Настройка технических и рабочих пределов"
                       Foreground="#65748B"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Padding="8">

            <!-- Датчики давления и температуры -->
            <TabItem Header="Давление и температура">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Технические диапазоны"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Датчик"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Минимум"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Максимум"/>

                            <TextBlock Grid.Row="1" Text="DD1_1"/>
                            <TextBox x:Name="DD1_1_Min" Grid.Row="1" Grid.Column="1" Text="-100"/>
                            <TextBox x:Name="DD1_1_Max" Grid.Row="1" Grid.Column="2" Text="2400"/>

                            <TextBlock Grid.Row="2" Text="DD1_2"/>
                            <TextBox x:Name="DD1_2_Min" Grid.Row="2" Grid.Column="1" Text="-100"/>
                            <TextBox x:Name="DD1_2_Max" Grid.Row="2" Grid.Column="2" Text="2400"/>

                            <TextBlock Grid.Row="3" Text="DD2_1"/>
                            <TextBox x:Name="DD2_1_Min" Grid.Row="3" Grid.Column="1" Text="-100"/>
                            <TextBox x:Name="DD2_1_Max" Grid.Row="3" Grid.Column="2" Text="2400"/>

                            <TextBlock Grid.Row="4" Text="DD2_2"/>
                            <TextBox x:Name="DD2_2_Min" Grid.Row="4" Grid.Column="1" Text="-100"/>
                            <TextBox x:Name="DD2_2_Max" Grid.Row="4" Grid.Column="2" Text="2400"/>

                            <TextBlock Grid.Row="5" Text="DD_Ger"/>
                            <TextBox x:Name="DD_Ger_Min" Grid.Row="5" Grid.Column="1" Text="-10"/>
                            <TextBox x:Name="DD_Ger_Max" Grid.Row="5" Grid.Column="2" Text="6000"/>

                            <TextBlock Grid.Row="6" Text="TM_Work (технический)"/>
                            <TextBox x:Name="TM_Work_Min" Grid.Row="6" Grid.Column="1" Text="-60"/>
                            <TextBox x:Name="TM_Work_Max" Grid.Row="6" Grid.Column="2" Text="180"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TM_Clear (технический)"/>
                            <TextBox x:Name="TM_Clear_Min" Grid.Column="1" Text="-60"/>
                            <TextBox x:Name="TM_Clear_Max" Grid.Column="2" Text="180"/>
                        </Grid>

                        <Separator Margin="0,16"/>

                        <TextBlock Text="Рабочие пределы температуры масла"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Датчик"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Минимум"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Максимум"/>

                            <TextBlock Grid.Row="1" Text="TM_Work"/>
                            <TextBox x:Name="TM_Work_Work_Min" Grid.Row="1" Grid.Column="1" Text="70"/>
                            <TextBox x:Name="TM_Work_Work_Max" Grid.Row="1" Grid.Column="2" Text="80"/>

                            <TextBlock Grid.Row="2" Text="TM_Clear"/>
                            <TextBox x:Name="TM_Clear_Work_Min" Grid.Row="2" Grid.Column="1" Text="70"/>
                            <TextBox x:Name="TM_Clear_Work_Max" Grid.Row="2" Grid.Column="2" Text="80"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вибродатчики -->
            <TabItem Header="Вибродатчики">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Датчик №1"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Параметр"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Минимум"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Максимум"/>

                            <TextBlock Grid.Row="1" Text="X"/>
                            <TextBox x:Name="V1_X_Min" Grid.Row="1" Grid.Column="1" Text="-999"/>
                            <TextBox x:Name="V1_X_Max" Grid.Row="1" Grid.Column="2" Text="999"/>

                            <TextBlock Grid.Row="2" Text="Y"/>
                            <TextBox x:Name="V1_Y_Min" Grid.Row="2" Grid.Column="1" Text="-999"/>
                            <TextBox x:Name="V1_Y_Max" Grid.Row="2" Grid.Column="2" Text="999"/>

                            <TextBlock Grid.Row="3" Text="Z"/>
                            <TextBox x:Name="V1_Z_Min" Grid.Row="3" Grid.Column="1" Text="-999"/>
                            <TextBox x:Name="V1_Z_Max" Grid.Row="3" Grid.Column="2" Text="999"/>

                            <TextBlock Grid.Row="4" Text="Модуль M"/>
                            <TextBox x:Name="V1_M_Min" Grid.Row="4" Grid.Column="1" Text="0"/>
                            <TextBox x:Name="V1_M_Max" Grid.Row="4" Grid.Column="2" Text="999"/>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Температура T"/>
                            <TextBox x:Name="V1_T_Min" Grid.Column="1" Text="-50"/>
                            <TextBox x:Name="V1_T_Max" Grid.Column="2" Text="200"/>
                        </Grid>

                        <CheckBox x:Name="V1_ZeroIsError"
                                  Content="Считать ошибкой, если все значения равны нулю"
                                  IsChecked="True"
                                  Margin="0,10"/>

                        <Separator Margin="0,8"/>

                        <TextBlock Text="Датчик №2"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Параметр"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Минимум"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Максимум"/>

                            <TextBlock Grid.Row="1" Text="X"/>
                            <TextBox x:Name="V2_X_Min" Grid.Row="1" Grid.Column="1" Text="-999"/>
                            <TextBox x:Name="V2_X_Max" Grid.Row="1" Grid.Column="2" Text="999"/>

                            <TextBlock Grid.Row="2" Text="Y"/>
                            <TextBox x:Name="V2_Y_Min" Grid.Row="2" Grid.Column="1" Text="-999"/>
                            <TextBox x:Name="V2_Y_Max" Grid.Row="2" Grid.Column="2" Text="999"/>

                            <TextBlock Grid.Row="3" Text="Z"/>
                            <TextBox x:Name="V2_Z_Min" Grid.Row="3" Grid.Column="1" Text="-999"/>
                            <TextBox x:Name="V2_Z_Max" Grid.Row="3" Grid.Column="2" Text="999"/>

                            <TextBlock Grid.Row="4" Text="Модуль M"/>
                            <TextBox x:Name="V2_M_Min" Grid.Row="4" Grid.Column="1" Text="0"/>
                            <TextBox x:Name="V2_M_Max" Grid.Row="4" Grid.Column="2" Text="999"/>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Температура T"/>
                            <TextBox x:Name="V2_T_Min" Grid.Column="1" Text="-50"/>
                            <TextBox x:Name="V2_T_Max" Grid.Column="2" Text="200"/>
                        </Grid>

                        <CheckBox x:Name="V2_ZeroIsError"
                                  Content="Считать ошибкой, если все значения равны нулю"
                                  IsChecked="True"
                                  Margin="0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Временные параметры -->
            <TabItem Header="Фильтры и расходомеры">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Расходомеры"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,10"/>

                        <TextBlock Text="Минимальный прирост импульсов за интервал измерения"/>
                        <TextBox x:Name="FlowmeterMinPulses" Text="100"/>

                        <TextBlock Text="Задержка запуска расходомера, мс"
                                   Margin="0,8,0,0"/>
                        <TextBox x:Name="FlowmeterStartDelay" Text="2000"/>

                        <TextBlock Text="Интервал между замерами, мс"
                                   Margin="0,8,0,0"/>
                        <TextBox x:Name="FlowmeterSampleInterval" Text="1000"/>

                        <Separator Margin="0,16"/>

                        <TextBlock Text="Датчик момента"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Тайм-аут ожидания момента в шаге Wait Torque, с"/>
                        <TextBox x:Name="TorqueWaitTimeout" Text="10"/>

                        <Separator Margin="0,16"/>

                        <TextBlock Text="Проверка фильтров"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Задержка перед проверкой фильтра, мс"/>
                        <TextBox x:Name="FilterCheckDelay" Text="5000"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Макс. разница давления фильтра 1:"/>
                        <TextBox x:Name="Filter1MaxPressureDifference"
                                 Text="0"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Макс. разница давления фильтра 2:"/>
                        <TextBox x:Name="Filter2MaxPressureDifference"
                                 Text="0"
                                 Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#65748B"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">
                <Button Content="Значения по умолчанию"
                        Click="DefaultsButton_Click"/>
                <Button Content="Отмена"
                        Click="CancelButton_Click"/>
                <Button Content="Сохранить"
                        Background="#2457C5"
                        Foreground="White"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
