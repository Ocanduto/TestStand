<Page x:Class="KreativStend.Pages.NewTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:c="clr-namespace:KreativStend.Components"
      xmlns:vm="clr-namespace:KreativStend.ViewModels"
      xmlns:local="clr-namespace:KreativStend.Pages"
      mc:Ignorable="d" 
      x:Name="root"
      Title="NewTestPage"
      d:DesignHeight="800" d:DesignWidth="800"
      MaxWidth="800"
      Background="#B3B3B3"
      d:DataContext="{d:DesignInstance Type=vm:ProcessStepsVM, IsDesignTimeCreatable=False}">

    <c:ModalControl Header="{Binding TestType, StringFormat='Новый: {0}'}" DataContext="{Binding}" ContentVerticalAlignment="Center">
        <GroupBox Header="Шаг">
            <ComboBox SelectedIndex="{Binding StartStepIndex}"  ItemsSource="{Binding LogicItems}" DisplayMemberPath="Operation">
            </ComboBox>
        </GroupBox>

        <UniformGrid Columns="2" HorizontalAlignment="Center" MinWidth="400">
            <Border Padding="5" Margin="2" BorderThickness="1" BorderBrush="LightGray" CornerRadius="5">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style TargetType="Label">
                            <Setter Property="Padding" Value="0,10,0,2"/>
                        </Style>
                    </StackPanel.Resources>
                    <Label Content="Тип моста" HorizontalContentAlignment="Center"/>
                    <TextBox Text="{Binding BridgeType, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" TextAlignment="Center" FontWeight="Bold"/>
                    <Label Content="Серийный номер моста" HorizontalContentAlignment="Center"/>
                    <TextBox Text="{Binding SerialNumberBridge, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Padding="5" Margin="2" BorderThickness="1" BorderBrush="LightGray" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button Grid.Column="0" Grid.Row="0" Content="1" Click="On_Keyboard_Click" Focusable="False"/>
                    <Button Grid.Column="1" Grid.Row="0" Content="2" Click="On_Keyboard_Click" Focusable="False"/>
                    <Button Grid.Column="2" Grid.Row="0" Content="3" Click="On_Keyboard_Click" Focusable="False"/>
                    <Button Grid.Column="0" Grid.Row="1" Content="4" Click="On_Keyboard_Click" Focusable="False"/>
                    <Button Grid.Column="1" Grid.Row="1" Content="5" Click="On_Keyboard_Click" Focusable="False"/>
                    <Button Grid.Column="2" Grid.Row="1" Content="6" Click="On_Keyboard_Click" Focusable="False"/>
                    <Button Grid.Column="0" Grid.Row="2" Content="7" Click="On_Keyboard_Click" Focusable="False"/>
                    <Button Grid.Column="1" Grid.Row="2" Content="8" Click="On_Keyboard_Click" Focusable="False"/>
                    <Button Grid.Column="2" Grid.Row="2" Content="9" Click="On_Keyboard_Click" Focusable="False"/>
                    <Button Grid.Column="0" Grid.Row="3" Content="0" Click="On_Keyboard_Click" Focusable="False"/>
                    <Button Grid.Column="1" Grid.Row="3" Content="." Click="On_Keyboard_Click" Focusable="False"/>
                    <Button Grid.Column="2" Grid.Row="3" Content="S" Click="On_Keyboard_Click" Focusable="False"/>
                    <Button Grid.Column="0" Grid.Row="4" Content="&lt;" CommandParameter="delete" Click="On_Keyboard_Click" Focusable="False"/>
                    <Button Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="4" Content="Пробел" CommandParameter="space" Click="On_Keyboard_Click" Focusable="False"/>
                </Grid>
            </Border>
        </UniformGrid>

        <c:ModalControl.Bottom>
            <UniformGrid Columns="1">
                <Button Content="НАЧАТЬ ИСПЫТАНИЯ" Command="{Binding Start_Command}" Style="{StaticResource primary}"/>
                <Button Content="ЗАКРЫТЬ" Command="{Binding Exit_Command}" Style="{StaticResource normal}"/>
            </UniformGrid>
        </c:ModalControl.Bottom>
    </c:ModalControl>
</Page>
