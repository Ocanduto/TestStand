<Page x:Class="KreativStend.Pages.Step1.BeforePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:c="clr-namespace:KreativStend.Components"
      xmlns:props="clr-namespace:KreativStend.Properties"
      xmlns:local="clr-namespace:KreativStend.Pages.Step1"
      xmlns:vm="clr-namespace:KreativStend.ViewModels"
      mc:Ignorable="d" 
      Title="NewTestPage"
      d:DesignHeight="800" d:DesignWidth="800"
      MaxWidth="800"
      Background="#B3B3B3"
      d:DataContext="{d:DesignInstance Type=vm:ProcessStepsVM, IsDesignTimeCreatable=False}">

    <c:ModalControl Header="{Binding TestType, StringFormat='Новый: {0}'}" DataContext="{Binding}">
        <Border BorderBrush="#FF9933" BorderThickness="5" Padding="50" Margin="20" MaxWidth="800">
            <TextBlock TextAlignment="Center" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding MessageWarning}"/>
        </Border>

        <c:ModalControl.Bottom>
            <UniformGrid Columns="2">
                <Button Content="ОТМЕНИТЬ" Command="{Binding Cancel_Command}" Style="{StaticResource danger}"/>
                <Button Content="ОК" Command="{Binding Success_Command}" Style="{StaticResource primary}"/>
            </UniformGrid>
        </c:ModalControl.Bottom>
    </c:ModalControl>
</Page>