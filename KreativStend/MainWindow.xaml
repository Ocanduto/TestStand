<Window x:Class="KreativStend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KreativStend.ViewModels"
        xmlns:pg="clr-namespace:KreativStend.Pages"
        xmlns:local="clr-namespace:KreativStend"
        mc:Ignorable="d"
        Title="Обкатка мостов" 
        WindowState="Maximized"
        Height="450" Width="800"
        Background="#B3B3B3">
    <Window.DataContext>
        <vm:MainWindowVM/>
    </Window.DataContext>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Height="40">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#3399FF"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=IsConnected, Source={x:Static local:App.ProcessKeys}}" Value="False">
                            <DataTrigger.Setters>
                                <Setter Property="Background" Value="Orange"/>
                            </DataTrigger.Setters>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- Треугольник-кнопка с изображением -->
                <Button x:Name="TriangleButton" 
                     Background="Transparent"
                     BorderThickness="0"
                     Width="48" 
                     Height="41"    
                     Margin="0,0,0,0"
                     HorizontalAlignment="Left">
                    <Grid>
                        <!-- Треугольник как фон -->
                        <Polygon x:Name="TriangleShape"
                          Points="23,0 0,40 46,40" 
                          Fill="{Binding TriangleColor}"/>

                        <!-- Область для изображения (треугольная маска) -->
                        <Grid x:Name="ImageContainer">
                            <Grid.Clip>
                                <PathGeometry>
                                    <PathFigure StartPoint="23,0">
                                        <LineSegment Point="0,40"/>
                                        <LineSegment Point="46,40"/>
                                        <LineSegment Point="25,0"/>
                                    </PathFigure>
                                </PathGeometry>
                            </Grid.Clip>

                            <!-- Изображение -->
                            <Image x:Name="TriangleImage"
                                Source="/Resources/warning.png"
                                Stretch="UniformToFill"
                                Width="46"
                                Height="40"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Button>

                <!--<Button x:Name="TriangleButton" Height="42" Width="48" HorizontalAlignment="Left">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                --><!-- Треугольник с биндингом на цвет --><!--
                                <Path Data="M1,0 L2,2 L0,2 Z" 
                                Stretch="Fill"
                                Fill="{Binding TriangleColor, FallbackValue=Orange}">           
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={x:Static local:App.ProcessKeys}, Path=Warning}" Value="True">
                                                    <Setter Property="Fill" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Source={x:Static local:App.ProcessKeys}, Path=Warning}" Value="False">
                                                    <Setter Property="Fill" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>

                                --><!-- Картинка поверх треугольника --><!--
                                <Image Source="/Resources/warning.png" Height="40"  Width="40"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>-->
                
                <TextBlock Foreground="White" Text="{Binding Title}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Button Grid.Column="1" Content="Конструктор" Style="{StaticResource normal}" Click="On_OpenLogicConstructor"/>
            </Grid>
        </Border>

        <Viewbox xmlns:c="clr-namespace:KreativStend.Components">
            <Grid IsEnabled="{Binding Source={x:Static local:App.ProcessKeys}, Path=IsConnected}">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource primary}">
                            <Setter Property="Margin" Value="1"/>
                            <Setter Property="Padding" Value="20,5"/>
                        </Style>
                    </Grid.Resources>

                    <c:HeaderedGroup DataContext="{Binding}" Title="НОВЫЙ ПРОЦЕСС" MinWidth="200" Grid.Column="0">
                        <Button CommandParameter="Загрузить скрипты" Command="{Binding LoadScripts}" Content="{Binding CommandParameter, RelativeSource={RelativeSource Self}}"/>
                        <ComboBox ItemsSource="{Binding ScriptItems}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedScript}"/>
                        <Button CommandParameter="Выполнить" Command="{Binding StartNewCycle}" Content="{Binding CommandParameter, RelativeSource={RelativeSource Self}}"/>
                        <Button Content="Сервисный режим" Click="On_OpenTestKeys"/>
                        <!--<Button CommandParameter="1300.02.82.810" Command="{Binding StartNewCycle}" Content="{Binding CommandParameter, RelativeSource={RelativeSource Self}}"/>
                        <Button CommandParameter="S300.02.82.810" Command="{Binding StartNewCycle}" Content="{Binding CommandParameter, RelativeSource={RelativeSource Self}}"/>
                        <Button CommandParameter="101.02.82.810" Command="{Binding StartNewCycle}" Content="{Binding CommandParameter, RelativeSource={RelativeSource Self}}"/>-->
                    </c:HeaderedGroup>

                    <UniformGrid Columns="2" Rows="3" Margin="10,-14,0,0" Grid.Column="1" Grid.Row="0">
                        <Button Content="ИСТОРИЯ" Command="{Binding On_StartScript}"/>
                    </UniformGrid>

                    <Image Grid.Column="0" Grid.Row="2" Height="40" Source="/Resources/newDinamika.png" HorizontalAlignment="Center"/>
                    <Grid Grid.Column="1" Grid.Row="2">
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <TextBlock Text="Made by" FontSize="8" Foreground="#2f4b60"/>
                            <Image Height="15" Source="/Resources/kreativ.png" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                </Grid>
                <Frame x:Name="frame" NavigationUIVisibility="Hidden"/>
            </Grid>
        </Viewbox>
    </DockPanel>
</Window>
