 <Window x:Class="KreativStend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KreativStend.ViewModels"
        xmlns:pg="clr-namespace:KreativStend.Pages"
        xmlns:local="clr-namespace:KreativStend"
        mc:Ignorable="d"
        Title="Обкатка Мостов"
        WindowState="Maximized"
        Height="450"
        Width="800"
        Background="#B3B3B3">

    <Window.DataContext>
        <vm:MainWindowVM/>
    </Window.DataContext>

    <DockPanel LastChildFill="True">

        <!-- Верхняя панель -->
        <Border DockPanel.Dock="Top" Height="40">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"
                Value="{Binding Source={x:Static local:App.ProcessKeys},
                                Path=ErrorManager.TopLineColor}"/>
                </Style>
            </Border.Style>


            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="TriangleButton"
                        Click="On_OpenErrorWindow"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="48"
                        Height="41"
                        HorizontalAlignment="Left">

                    <Grid>
                        <Polygon x:Name="TriangleShape"
                                 Points="23,0 0,40 46,40"
                                 Fill="{Binding TriangleColor}"/>

                        <Grid x:Name="ImageContainer">
                            <Grid.Clip>
                                <PathGeometry>
                                    <PathFigure StartPoint="23,0">
                                        <LineSegment Point="0,40"/>
                                        <LineSegment Point="46,40"/>
                                        <LineSegment Point="25,0"/>
                                    </PathFigure>
                                </PathGeometry>
                            </Grid.Clip>

                            <Image x:Name="TriangleImage"
                                   Source="/Resources/warning.png"
                                   Stretch="UniformToFill"
                                   Width="46"
                                   Height="40"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Button>

                <TextBlock Text="{Binding Title}"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Конструктор"
                        Style="{StaticResource normal}"
                        Click="On_OpenLogicConstructor"/>
            </Grid>
        </Border>

        <!-- Основная область.
             Здесь больше нет блокировки через IsConnected. -->
        <Viewbox>
            <Grid>
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.Resources>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource primary}">
                            <Setter Property="Margin" Value="1"/>
                            <Setter Property="Padding" Value="20,5"/>
                        </Style>
                    </Grid.Resources>

                    <c:HeaderedGroup
                        xmlns:c="clr-namespace:KreativStend.Components"
                        DataContext="{Binding}"
                        Title="НОВЫЙ ПРОЦЕСС"
                        MinWidth="200"
                        Grid.Column="0">

                        <Button Content="Загрузить скрипты"
                                Command="{Binding LoadScripts}"
                                IsEnabled="{Binding
                                    Source={x:Static local:App.ProcessKeys},
                                    Path=ErrorManager.CanStartTest}"/>

                        <ComboBox ItemsSource="{Binding ScriptItems}"
                                  DisplayMemberPath="Title"
                                  SelectedItem="{Binding SelectedScript}"
                                  IsEnabled="{Binding
                                      Source={x:Static local:App.ProcessKeys},
                                      Path=ErrorManager.CanStartTest}"/>

                        <Button Content="Выполнить"
                                Command="{Binding StartNewCycle}"
                                IsEnabled="{Binding
                                    Source={x:Static local:App.ProcessKeys},
                                    Path=ErrorManager.CanStartTest}"/>

                        <!-- Всегда доступен, даже при активных ошибках -->
                        <Button Content="Сервисный режим"
                                Click="On_OpenTestKeys"/>
                    </c:HeaderedGroup>

                    <!-- Изображение в нижней части -->
                    <Image Grid.Column="0"
                           Grid.Row="2"
                           Height="40"
                           Source="/Resources/newDinamika.png"
                           HorizontalAlignment="Center"/>

                    <Grid Grid.Column="1" Grid.Row="2">
                        <StackPanel VerticalAlignment="Bottom"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="Made by"
                                       FontSize="8"
                                       Foreground="#2f4b60"/>

                            <Image Height="15"
                                   Source="/Resources/kreativ.png"
                                   HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Frame x:Name="frame"
                       NavigationUIVisibility="Hidden"/>
            </Grid>
        </Viewbox>
    </DockPanel>
</Window>