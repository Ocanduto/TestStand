@page "{id}"
@model ReportModel
@{
    ViewData["Title"] = "Реестр испытаний";
}

@if (Model.Item == null)
{
    <div class="text-center">
        <h1>Изделие не найдено</h1>
    </div>
}
else
{
    <div class="d-flex mb-3">
        <div class="p-2">
            <h1>Отчет @Model.Id</h1>
        </div>
        <div class="ms-auto p-2">
            <div class="btn-group" role="group" aria-label="Basic example">
                <button type="button" class="btn btn-outline-primary" id="exportToWord"><i class="bi bi-file-earmark-word"></i> выгрузить в word</button>
                <button type="button" class="btn btn-outline-primary" id="exportToExcel"><i class="bi bi-file-earmark-excel"></i> выгрузить в excel</button>
            </div>
        </div>
    </div>

    <table class="table table-striped table-hover table-bordered text-center align-middle">
        <thead>
            <tr>
                <th scope="col">Отметка</th>
                <th scope="col">Обозначение изделия</th>
                <th scope="col">Серийный номер моста</th>
                <th scope="col">Серийный номер гидромотора</th>
                <th scope="col">Серийный номер клапана</th>
                <th scope="col">Номер клейма</th>
                <th scope="col">Оператор</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@(Model.Item.CreateDate.ToLocalTime())</td>
                <td>@(Model.Item.TestType)</td>
                <td>@(Model.Item.SerialNumberBridge)</td>
                <td>@(Model.Item.SerialNumberHydro)</td>
                <td>@(Model.Item.SerialNumberValve)</td>
                <td>@(Model.Item.Operator)</td>
                <td>@(Model.Item.Operator)</td>
            </tr>
        </tbody>
    </table>

    <table class="table table-striped table-hover table-bordered text-center align-middle">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Отметка</th>
                <th scope="col">Операция</th>
                <th scope="col">Инфо</th>
                <th scope="col">Статус</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Data.Items)
            {
                <tr>
                    <th scope="row">@item.Id</th>
                    <td>@(item.CreateDate.ToLocalTime())</td>
                    <td>@item.StepText</td>
                    <td>@item.Info</td>
                    <td style="font-size: 18pt">
                        @if (item.Result)
                        {
                            <i class="bi bi-check-circle-fill" style="color: limegreen"></i>
                        }
                        else
                        {
                            <i class="bi bi-x-circle-fill" style="color: orangered"></i>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex mb-3">
        <div class="p-2">
            <ul class="pagination">
                <li class="page-item@(Model.Data.HasPreviousPage ? string.Empty : " disabled")"><a class="page-link" asp-page="Report" asp-route-id="@(Model.Id)" asp-route-pageIndex="@(Model.Data.PageNumber-1)">Назад</a></li>
                <li class="page-item@(Model.Data.HasNextPage ? string.Empty : " disabled")"><a class="page-link" asp-page="Report" asp-route-id="@(Model.Id)" asp-route-pageIndex="@(Model.Data.PageNumber+1)">Вперед</a></li>
            </ul>
        </div>
        <div class="ms-auto p-2">
            <span><i class="bi bi-check-circle-fill" style="color: limegreen"></i> - Выполнено</span>
            <span><i class="bi bi-x-circle-fill" style="color: orangered"></i> - Прервано</span>
        </div>
    </div>
    @section Scripts {
    <script>
        $(document).ready(function(){
            $("#exportToWord").click(function(e){
                e.preventDefault();
                window.location.href = '/api/export/word/@(Model.Id)';
            });
            $("#exportToExcel").click(function(e){
                e.preventDefault();
                window.location.href = '/api/export/excel/@(Model.Id)';
            });
        });
    </script>
    }
}