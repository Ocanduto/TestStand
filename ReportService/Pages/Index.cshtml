@page
@model IndexModel
@{
    ViewData["Title"] = "Реестр испытаний";
}

<table class="table table-striped table-hover table-bordered text-center align-middle">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Отметка</th>
            <th scope="col">Изделие</th>
            <th scope="col">Номер моста</th>
            <th scope="col">Оператор</th>
            <th scope="col">Статус</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Data.Items)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@(item.CreateDate.ToLocalTime())</td>
                <td>@item.BridgeType</td>
                <td>@item.SerialNumberBridge</td>
                <td>@item.Operator</td>
                <td style="font-size: 18pt">
                    @if (item.State == 1)
                    {
                        <i class="bi bi-check-circle-fill" style="color: limegreen"></i>
                    }
                    else if (item.State == 2)
                    {
                        <i class="bi bi-dash-circle-fill" style="color: dimgray"></i>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill" style="color: orangered"></i>
                    }
                </td>
                <td><a href="/Report/@(item.Id)" class="btn btn-outline-primary">Открыть</a></td>
            </tr>
        }
    </tbody>
</table>
<div class="d-flex mb-3">
    <div class="p-2">
        <ul class="pagination">
            <li class="page-item@(Model.Data.HasPreviousPage ? string.Empty : " disabled")"><a class="page-link" asp-page="Index" asp-route-pageIndex="@(Model.Data.PageNumber-1)">Назад</a></li>
            <li class="page-item@(Model.Data.HasNextPage ? string.Empty : " disabled")"><a class="page-link" asp-page="Index" asp-route-pageIndex="@(Model.Data.PageNumber+1)">Вперед</a></li>
        </ul>
    </div>
    <div class="ms-auto p-2">
        <span><i class="bi bi-check-circle-fill" style="color: limegreen"></i> - Выполнено</span>
        <span><i class="bi bi-dash-circle-fill" style="color: dimgray"></i> - Выполнено с условиями</span>
        <span><i class="bi bi-x-circle-fill" style="color: orangered"></i> - Прервано</span>
    </div>
</div>
